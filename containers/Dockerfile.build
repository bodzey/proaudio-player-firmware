FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bash bc binutils bison build-essential bzip2 ca-certificates cpio file \
        findutils flex gawk git gzip libncurses-dev make patch perl python3 \
        rsync sed tar unzip util-linux wget which xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/tmp \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8

WORKDIR /workspace
ENTRYPOINT ["./scripts/build.sh", "--no-submodules"]
