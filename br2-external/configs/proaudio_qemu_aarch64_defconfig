BR2_aarch64=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_INSTALL_LIBSTDCPP=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_TARGET_GENERIC_HOSTNAME="proaudio-player-qemu"
BR2_TARGET_GENERIC_ISSUE="ProAudio Player - QEMU AArch64 DEV"
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_DHCP="eth0"
BR2_SYSTEM_DEFAULT_PATH="/bin:/sbin:/usr/bin:/usr/sbin"
BR2_TARGET_TZ_ZONELIST="europe"
BR2_TARGET_LOCALTIME="Europe/Kyiv"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PROAUDIO_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_PROAUDIO_PATH)/board/qemu-aarch64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PROAUDIO_PATH)/board/common/post-build-native.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qemu/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_DEFCONFIG)"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# BR2_PACKAGE_FFMPEG_FFMPEG is not set
# BR2_PACKAGE_MPD_ALSA is not set
# BR2_PACKAGE_MPD_MAD is not set
# BR2_PACKAGE_AVAHI_AUTOIPD is not set
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
# BR2_PACKAGE_PROAUDIO_PLAYER is not set
BR2_PACKAGE_PROAUDIO_PLAYER_NATIVE=y
BR2_PACKAGE_PROAUDIO_WEBUI=y
# BR2_PACKAGE_PROAUDIO_NETWORKD is not set
