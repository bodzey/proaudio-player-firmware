[Unit]
Description=DLNA/UPnP renderer for ProAudio Player
After=proaudio-player-buses.service
Wants=proaudio-player-buses.service

[Service]
Type=simple
User=proaudio-player
Group=proaudio-player
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
Environment=PULSE_SERVER=unix:/run/pulse/native
Environment=PULSE_SINK=proaudio_player_music
Environment=DLNA_INTERFACE=proaudio-dlna
ExecStartPre=+/bin/sh -c '/sbin/ip link show proaudio-dlna >/dev/null 2>&1 || /sbin/ip link add proaudio-dlna type dummy'
ExecStartPre=+/sbin/ip link set proaudio-dlna multicast on
ExecStartPre=+/sbin/ip addr replace 169.254.253.1/32 dev proaudio-dlna
ExecStartPre=+/sbin/ip link set proaudio-dlna up
ExecStart=/usr/libexec/proaudio-player/dlna-renderer.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
