[Unit]
Description=ProAudio Player Wi-Fi provisioning
After=dbus.service NetworkManager.service systemd-udevd.service
Requires=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/sbin/proaudio-networkd
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
