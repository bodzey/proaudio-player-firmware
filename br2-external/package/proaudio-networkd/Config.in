config BR2_PACKAGE_PROAUDIO_NETWORKD
	bool "proaudio-networkd Wi-Fi provisioning"
	depends on BR2_INIT_SYSTEMD
	depends on BR2_PACKAGE_HAS_UDEV
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_USE_MMU
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX
	select BR2_PACKAGE_NETWORK_MANAGER
	select BR2_PACKAGE_NETWORK_MANAGER_CLI
	select BR2_PACKAGE_WPA_SUPPLICANT
	select BR2_PACKAGE_WPA_SUPPLICANT_NL80211
	select BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT
	select BR2_PACKAGE_WPA_SUPPLICANT_WPA3
	select BR2_PACKAGE_WPA_SUPPLICANT_DBUS
	select BR2_PACKAGE_DNSMASQ
	select BR2_PACKAGE_DNSMASQ_DHCP
	select BR2_PACKAGE_LIBGPIOD
	select BR2_PACKAGE_LIBGPIOD_TOOLS
	select BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI
	select BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI
	select BR2_PACKAGE_IW
	select BR2_PACKAGE_WIRELESS_REGDB
	help
	  Rust headless Wi-Fi provisioning service for ProAudio Player.
	  It owns first-boot setup AP/captive portal behavior, Ethernet
	  preference, Wi-Fi recovery and the physical setup button.
	  Python is not required by the target runtime.

comment "proaudio-networkd requirements are not satisfied"
	depends on !BR2_INIT_SYSTEMD || !BR2_PACKAGE_HAS_UDEV || 		!BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS || !BR2_USE_MMU || 		BR2_STATIC_LIBS || !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || 		BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX
