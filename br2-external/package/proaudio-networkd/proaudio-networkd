#!/usr/bin/env python3
import html
import http.server
import logging
import os
import signal
import subprocess
import threading
import time
import urllib.parse

CONFIG_PATH = "/etc/proaudio-networkd.conf"
WIFI_PROFILE = "proaudio-wifi"
SETUP_PROFILE = "proaudio-setup"

DEFAULTS = {
    "WIFI_IFACE": "auto",
    "SETUP_SSID_PREFIX": "ProAudio",
    "SETUP_PASSWORD": "proaudio-setup",
    "SETUP_ADDRESS": "192.168.4.1",
    "SETUP_PREFIX": "24",
    "SETUP_DHCP_START": "192.168.4.20",
    "SETUP_DHCP_END": "192.168.4.100",
    "SETUP_CHANNEL": "6",
    "SETUP_TIMEOUT": "600",
    "REGDOMAIN": "UA",
    "GPIO_CHIP": "/dev/gpiochip0",
    "GPIO_LINE": "17",
    "GPIO_HOLD_SECONDS": "5",
}

LOG = logging.getLogger("proaudio-networkd")


def load_config(path=CONFIG_PATH):
    cfg = dict(DEFAULTS)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"').strip("'")
                if key in cfg:
                    cfg[key] = value
    except FileNotFoundError:
        pass
    return cfg


def split_escaped(line):
    fields, current = [], []
    escaped = False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    fields.append("".join(current))
    return fields


def command(args, timeout=30):
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    return subprocess.run(
        args,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
        env=env,
        check=False,
    )


class PortalServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


class PortalHandler(http.server.BaseHTTPRequestHandler):
    server_version = "ProAudioProvisioning/1.0"

    @property
    def daemon(self):
        return self.server.proaudio_daemon

    def log_message(self, fmt, *args):
        LOG.debug("portal: " + fmt, *args)

    def _send_html(self, body, status=200):
        payload = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        self._send_html(self.daemon.portal_page())

    def do_POST(self):
        if self.path.rstrip("/") != "/connect":
            self._send_html(self.daemon.portal_page(), 404)
            return
        try:
            length = min(int(self.headers.get("Content-Length", "0")), 4096)
        except ValueError:
            length = 0
        form = urllib.parse.parse_qs(
            self.rfile.read(length).decode("utf-8", "replace"),
            keep_blank_values=True,
        )
        ssid = form.get("ssid", [""])[0].strip()
        password = form.get("password", [""])[0]
        if not ssid:
            self.daemon.set_error("Оберіть або введіть SSID.")
            self._send_html(self.daemon.portal_page(), 400)
            return
        if len(ssid.encode("utf-8")) > 32:
            self.daemon.set_error("SSID перевищує 32 байти.")
            self._send_html(self.daemon.portal_page(), 400)
            return
        if len(password) > 128:
            self.daemon.set_error("Пароль надто довгий.")
            self._send_html(self.daemon.portal_page(), 400)
            return
        if not self.daemon.begin_connect(ssid, password):
            self._send_html(self.daemon.portal_page(), 409)
            return
        self._send_html(
            """<!doctype html><html lang="uk"><meta charset="utf-8">
            <meta name="viewport" content="width=device-width,initial-scale=1">
            <title>ProAudio Player</title>
            <style>body{font-family:sans-serif;max-width:520px;margin:48px auto;padding:0 20px}</style>
            <h2>Підключення…</h2>
            <p>Точка налаштування тимчасово зникне. Якщо дані правильні,
            ProAudio Player підключиться до вибраної мережі. Якщо ні —
            точка налаштування з’явиться знову.</p></html>"""
        )


class NetworkDaemon:
    def __init__(self):
        self.cfg = load_config()
        self.iface = None
        self.networks = []
        self.last_error = ""
        self.connecting = False
        self.setup_active = False
        self.setup_request = threading.Event()
        self.setup_complete = threading.Event()
        self.lock = threading.RLock()
        self.dnsmasq = None
        self.httpd = None
        self.stop_event = threading.Event()

    def set_error(self, message):
        with self.lock:
            self.last_error = message

    def nmcli(self, *args, timeout=30):
        return command(["/usr/bin/nmcli", *args], timeout=timeout)

    def find_wifi_interface(self):
        requested = self.cfg["WIFI_IFACE"]
        if requested != "auto":
            return requested
        result = self.nmcli("-t", "-e", "yes", "-f", "DEVICE,TYPE", "device", "status")
        if result.returncode != 0:
            return None
        for line in result.stdout.splitlines():
            parts = split_escaped(line)
            if len(parts) >= 2 and parts[1] == "wifi":
                return parts[0]
        return None

    def wait_for_networkmanager(self):
        deadline = time.monotonic() + 45
        while time.monotonic() < deadline and not self.stop_event.is_set():
            result = self.nmcli("-t", "-f", "RUNNING", "general", timeout=5)
            if result.returncode == 0 and "running" in result.stdout.lower():
                return True
            time.sleep(1)
        return False

    def configure_regdomain(self):
        country = self.cfg["REGDOMAIN"].strip().upper()
        if country and len(country) == 2 and os.path.exists("/usr/sbin/iw"):
            result = command(["/usr/sbin/iw", "reg", "set", country], timeout=5)
            if result.returncode != 0:
                LOG.warning("Не вдалося встановити regulatory domain %s: %s", country, result.stderr.strip())

    def has_wifi_profile(self):
        result = self.nmcli("-t", "-f", "NAME", "connection", "show", WIFI_PROFILE)
        return result.returncode == 0 and WIFI_PROFILE in result.stdout.splitlines()

    def device_serial_suffix(self):
        serial = ""
        try:
            with open("/proc/cpuinfo", "r", encoding="utf-8", errors="ignore") as handle:
                for line in handle:
                    if line.lower().startswith("serial"):
                        serial = line.split(":", 1)[1].strip()
                        break
        except OSError:
            pass
        if not serial:
            try:
                with open("/etc/machine-id", "r", encoding="ascii") as handle:
                    serial = handle.read().strip()
            except OSError:
                serial = "0000"
        cleaned = "".join(ch for ch in serial.upper() if ch.isalnum())
        return (cleaned[-4:] or "0000").rjust(4, "0")

    def setup_ssid(self):
        prefix = self.cfg["SETUP_SSID_PREFIX"].strip() or "ProAudio"
        return f"{prefix}-{self.device_serial_suffix()}"

    def scan(self):
        self.nmcli("radio", "wifi", "on", timeout=10)
        self.configure_regdomain()
        self.nmcli("device", "wifi", "rescan", "ifname", self.iface, timeout=15)
        time.sleep(2)
        result = self.nmcli(
            "-t", "-e", "yes",
            "-f", "SSID,SIGNAL,SECURITY",
            "device", "wifi", "list",
            "ifname", self.iface,
            "--rescan", "no",
            timeout=20,
        )
        if result.returncode != 0:
            LOG.warning("Wi-Fi scan failed: %s", result.stderr.strip())
            return
        found = {}
        for line in result.stdout.splitlines():
            parts = split_escaped(line)
            if len(parts) < 3:
                continue
            ssid = parts[0].strip()
            if not ssid or ssid == self.setup_ssid():
                continue
            try:
                signal_value = int(parts[1])
            except ValueError:
                signal_value = 0
            security = parts[2].strip() or "Open"
            old = found.get(ssid)
            if old is None or signal_value > old["signal"]:
                found[ssid] = {
                    "ssid": ssid,
                    "signal": signal_value,
                    "security": security,
                }
        with self.lock:
            self.networks = sorted(found.values(), key=lambda x: (-x["signal"], x["ssid"].lower()))
        LOG.info("Знайдено Wi-Fi мереж: %d", len(found))

    def _delete_connection(self, name):
        self.nmcli("connection", "delete", name, timeout=10)

    def start_ap(self):
        self.stop_dnsmasq()
        self._delete_connection(SETUP_PROFILE)
        ssid = self.setup_ssid()
        password = self.cfg["SETUP_PASSWORD"]
        add = self.nmcli(
            "connection", "add",
            "type", "wifi",
            "ifname", self.iface,
            "con-name", SETUP_PROFILE,
            "ssid", ssid,
            timeout=15,
        )
        if add.returncode != 0:
            raise RuntimeError(add.stderr.strip() or "Не вдалося створити setup Wi-Fi profile")
        address = self.cfg["SETUP_ADDRESS"]
        prefix = self.cfg["SETUP_PREFIX"]
        channel = self.cfg["SETUP_CHANNEL"]
        modify_args = [
            "connection", "modify", SETUP_PROFILE,
            "connection.autoconnect", "no",
            "802-11-wireless.mode", "ap",
            "802-11-wireless.band", "bg",
            "802-11-wireless.channel", channel,
            "802-11-wireless.powersave", "2",
            "ipv4.method", "manual",
            "ipv4.addresses", f"{address}/{prefix}",
            "ipv4.never-default", "yes",
            "ipv6.method", "disabled",
        ]
        if password:
            modify_args += [
                "802-11-wireless-security.key-mgmt", "wpa-psk",
                "802-11-wireless-security.proto", "rsn",
                "802-11-wireless-security.psk", password,
            ]
        modified = self.nmcli(*modify_args, timeout=15)
        if modified.returncode != 0:
            raise RuntimeError(modified.stderr.strip() or "Не вдалося налаштувати setup Wi-Fi profile")
        up = self.nmcli("--wait", "20", "connection", "up", SETUP_PROFILE, "ifname", self.iface, timeout=25)
        if up.returncode != 0:
            raise RuntimeError(up.stderr.strip() or "Не вдалося запустити setup hotspot")
        self.start_dnsmasq()
        with self.lock:
            self.setup_active = True
        LOG.info("Setup AP активний: SSID=%s, portal=http://%s/", ssid, address)

    def stop_ap(self):
        self.stop_dnsmasq()
        self.nmcli("connection", "down", SETUP_PROFILE, timeout=10)
        self._delete_connection(SETUP_PROFILE)
        with self.lock:
            self.setup_active = False

    def start_dnsmasq(self):
        self.stop_dnsmasq()
        addr = self.cfg["SETUP_ADDRESS"]
        start = self.cfg["SETUP_DHCP_START"]
        end = self.cfg["SETUP_DHCP_END"]
        args = [
            "/usr/sbin/dnsmasq",
            "--no-daemon",
            "--conf-file=/dev/null",
            f"--interface={self.iface}",
            "--bind-interfaces",
            f"--listen-address={addr}",
            f"--dhcp-range={start},{end},255.255.255.0,10m",
            f"--dhcp-option=3,{addr}",
            f"--dhcp-option=6,{addr}",
            f"--address=/#/{addr}",
            "--no-resolv",
            "--no-hosts",
        ]
        self.dnsmasq = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
        time.sleep(0.25)
        if self.dnsmasq.poll() is not None:
            raise RuntimeError("dnsmasq не запустився")

    def stop_dnsmasq(self):
        proc = self.dnsmasq
        self.dnsmasq = None
        if proc is None:
            return
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=2)

    def portal_page(self):
        with self.lock:
            networks = list(self.networks)
            error = self.last_error
            connecting = self.connecting
        options = "\n".join(
            f'<option value="{html.escape(item["ssid"], quote=True)}">'
            f'{html.escape(item["ssid"])} — {item["signal"]}% — {html.escape(item["security"])}</option>'
            for item in networks
        )
        error_html = f'<div class="error">{html.escape(error)}</div>' if error else ""
        disabled = " disabled" if connecting else ""
        return f"""<!doctype html>
<html lang="uk"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ProAudio Player — Wi-Fi</title>
<style>
body{{font-family:system-ui,sans-serif;background:#f5f5f5;margin:0;color:#161616}}
main{{max-width:520px;margin:0 auto;padding:32px 20px}}
.card{{background:white;border-radius:14px;padding:24px;box-shadow:0 2px 14px #0001}}
h1{{font-size:24px;margin-top:0}}label{{display:block;margin:16px 0 6px}}
input{{width:100%;box-sizing:border-box;padding:12px;border:1px solid #bbb;border-radius:8px;font-size:16px}}
button{{margin-top:20px;width:100%;padding:13px;border:0;border-radius:8px;background:#111;color:#fff;font-size:16px}}
small{{color:#666}}.error{{background:#fee;color:#900;padding:10px;border-radius:8px;margin:12px 0}}
</style></head><body><main><div class="card">
<h1>ProAudio Player</h1>
<p>Виберіть Wi-Fi мережу та введіть пароль.</p>
{error_html}
<form method="post" action="/connect">
<label for="ssid">Wi-Fi мережа</label>
<input id="ssid" name="ssid" list="networks" maxlength="32" required autocomplete="off">
<datalist id="networks">{options}</datalist>
<label for="password">Пароль</label>
<input id="password" name="password" type="password" autocomplete="current-password">
<small>Для відкритої мережі залиште поле порожнім.</small>
<button type="submit"{disabled}>Підключити</button>
</form>
<p><small>Setup AP: {html.escape(self.setup_ssid())} · {html.escape(self.cfg["SETUP_ADDRESS"])}</small></p>
</div></main></body></html>"""

    def begin_connect(self, ssid, password):
        with self.lock:
            if self.connecting:
                self.last_error = "Підключення вже виконується."
                return False
            self.connecting = True
            self.last_error = ""
        threading.Thread(
            target=self._connect_worker,
            args=(ssid, password),
            name="wifi-connect",
            daemon=True,
        ).start()
        return True

    def _connect_worker(self, ssid, password):
        time.sleep(1)
        try:
            self.stop_dnsmasq()
            self.nmcli("connection", "down", SETUP_PROFILE, timeout=10)
            self._delete_connection(WIFI_PROFILE)
            args = [
                "--wait", "25",
                "device", "wifi", "connect", ssid,
                "ifname", self.iface,
                "name", WIFI_PROFILE,
            ]
            if password:
                args += ["password", password]
            result = self.nmcli(*args, timeout=35)
            if result.returncode == 0:
                self.nmcli(
                    "connection", "modify", WIFI_PROFILE,
                    "connection.autoconnect", "yes",
                    "connection.autoconnect-priority", "100",
                    "802-11-wireless.powersave", "2",
                    timeout=10,
                )
                LOG.info("Wi-Fi provisioning успішний: SSID=%s", ssid)
                self.setup_complete.set()
                return
            error = result.stderr.strip() or result.stdout.strip() or "Не вдалося підключитися."
            LOG.warning("Wi-Fi provisioning failed for %s: %s", ssid, error)
            self._delete_connection(WIFI_PROFILE)
            self.set_error(f"Не вдалося підключитися до «{ssid}». Перевірте пароль і спробуйте ще раз.")
            self.scan()
            self.start_ap()
        except Exception as exc:
            LOG.exception("Помилка підключення до Wi-Fi")
            self._delete_connection(WIFI_PROFILE)
            self.set_error(f"Помилка Wi-Fi: {exc}")
            try:
                self.start_ap()
            except Exception:
                LOG.exception("Не вдалося відновити setup hotspot")
        finally:
            with self.lock:
                self.connecting = False

    def run_portal(self, timeout_seconds=None):
        self.setup_complete.clear()
        self.set_error("")
        self.scan()
        self.start_ap()
        self.httpd = PortalServer(("0.0.0.0", 80), PortalHandler)
        self.httpd.proaudio_daemon = self
        server_thread = threading.Thread(target=self.httpd.serve_forever, name="portal-http", daemon=True)
        server_thread.start()
        deadline = None if timeout_seconds is None else time.monotonic() + timeout_seconds
        try:
            while not self.stop_event.is_set() and not self.setup_complete.is_set():
                if deadline is not None and time.monotonic() >= deadline:
                    LOG.info("Setup mode timeout")
                    break
                time.sleep(0.25)
        finally:
            if self.httpd is not None:
                self.httpd.shutdown()
                self.httpd.server_close()
                self.httpd = None
            self.stop_ap()

    def request_setup(self, *_args):
        self.setup_request.set()

    def gpio_button_worker(self):
        try:
            import gpiod
        except Exception as exc:
            LOG.warning("GPIO setup button недоступна: %s", exc)
            return
        chip = self.cfg["GPIO_CHIP"]
        try:
            line = int(self.cfg["GPIO_LINE"])
            hold = float(self.cfg["GPIO_HOLD_SECONDS"])
            settings = gpiod.LineSettings(
                direction=gpiod.line.Direction.INPUT,
                bias=gpiod.line.Bias.PULL_UP,
            )
            with gpiod.request_lines(
                chip,
                consumer="proaudio-networkd",
                config={line: settings},
            ) as request:
                pressed_since = None
                triggered = False
                while not self.stop_event.is_set():
                    value = request.get_value(line)
                    pressed = value == gpiod.line.Value.INACTIVE
                    now = time.monotonic()
                    if pressed:
                        if pressed_since is None:
                            pressed_since = now
                        elif not triggered and now - pressed_since >= hold:
                            LOG.info("GPIO%d утримується %.1f с: вхід у Setup Mode", line, hold)
                            self.setup_request.set()
                            triggered = True
                    else:
                        pressed_since = None
                        triggered = False
                    time.sleep(0.1)
        except Exception:
            LOG.exception("GPIO setup button monitor failed")

    def run(self):
        if not self.wait_for_networkmanager():
            raise RuntimeError("NetworkManager не готовий")
        self.nmcli("radio", "wifi", "on", timeout=10)
        self.configure_regdomain()
        for _ in range(30):
            self.iface = self.find_wifi_interface()
            if self.iface:
                break
            time.sleep(1)
        if not self.iface:
            raise RuntimeError("Wi-Fi interface не знайдено")
        LOG.info("Wi-Fi interface: %s", self.iface)
        threading.Thread(target=self.gpio_button_worker, name="gpio-button", daemon=True).start()

        if not self.has_wifi_profile():
            LOG.info("Збереженої Wi-Fi мережі немає: автоматичний Setup Mode")
            self.run_portal(timeout_seconds=None)

        timeout = max(60, int(self.cfg["SETUP_TIMEOUT"]))
        while not self.stop_event.is_set():
            if not self.setup_request.wait(timeout=0.5):
                continue
            self.setup_request.clear()
            if self.stop_event.is_set():
                break
            LOG.info("Примусовий Setup Mode")
            self.run_portal(timeout_seconds=timeout)

    def stop(self, *_args):
        self.stop_event.set()
        self.setup_request.set()
        self.setup_complete.set()
        self.stop_dnsmasq()


def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    daemon = NetworkDaemon()
    signal.signal(signal.SIGTERM, daemon.stop)
    signal.signal(signal.SIGINT, daemon.stop)
    signal.signal(signal.SIGUSR1, daemon.request_setup)
    try:
        daemon.run()
    finally:
        daemon.stop_ap()


if __name__ == "__main__":
    main()
