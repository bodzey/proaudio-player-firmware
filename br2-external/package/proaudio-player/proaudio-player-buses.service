[Unit]
Description=ProAudio Player native PipeWire music and priority buses
After=pipewire.service wireplumber.service
Requires=pipewire.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=oneshot
User=proaudio-player
Group=proaudio-player
RuntimeDirectory=proaudio-player
RuntimeDirectoryMode=0750
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
EnvironmentFile=-/etc/proaudio-player-alert/audio.env
EnvironmentFile=-/var/lib/proaudio-player-alert/audio-output.env
ExecStart=/usr/libexec/proaudio-player/audio-buses.sh start
ExecStop=/usr/libexec/proaudio-player/audio-buses.sh stop
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
