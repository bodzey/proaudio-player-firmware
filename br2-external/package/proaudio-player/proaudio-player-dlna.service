[Unit]
Description=DLNA/UPnP renderer for ProAudio Player
After=network.target proaudio-player-buses.service
Requires=proaudio-player-buses.service

[Service]
Type=simple
User=proaudio-player
Group=proaudio-player
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
Environment=PULSE_SERVER=unix:/run/pulse/native
Environment=PULSE_SINK=proaudio_player_music
ExecStart=/usr/libexec/proaudio-player/dlna-renderer.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
