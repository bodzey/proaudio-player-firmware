[Unit]
Description=ProAudio Player air-raid priority audio controller
After=network-online.target proaudio-player-buses.service
Wants=network-online.target
Requires=proaudio-player-buses.service
ConditionPathExists=/var/lib/proaudio-player-alert/media/alarm_start.mp3
ConditionPathExists=/var/lib/proaudio-player-alert/media/alarm_end.mp3
ConditionPathExists=/var/lib/proaudio-player-alert/media/minute_silence.mp3

[Service]
Type=simple
User=proaudio-player
Group=proaudio-player
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
Environment=PULSE_SERVER=unix:/run/pulse/native
Environment=PULSE_SINK=proaudio_player_alert
ExecStart=/usr/bin/proaudio-player-alert --config /etc/proaudio-player-alert/config.yaml run
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
