[Unit]
Description=ProAudio Player final output safety limiter
After=proaudio-player-buses.service pipewire.service pipewire-pulse.service wireplumber.service
Requires=proaudio-player-buses.service pipewire.service pipewire-pulse.service wireplumber.service
PartOf=proaudio-player-buses.service

[Service]
Type=simple
User=proaudio-player
Group=proaudio-player
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
Environment=PULSE_SERVER=unix:/run/pulse/native
ExecStart=/usr/libexec/proaudio-player/proaudio-player-limiter-start
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
