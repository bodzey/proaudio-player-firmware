config BR2_PACKAGE_PROAUDIO_PLAYER
	bool "proaudio-player"
	depends on BR2_INIT_SYSTEMD
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_TOOLCHAIN_HAS_ATOMIC
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_12
	depends on BR2_HOST_GCC_AT_LEAST_10
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_5_6
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS
	depends on BR2_PACKAGE_PULSEAUDIO_HAS_ATOMIC
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_BASH
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_SYSTEMD_TIMESYNCD
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON_AIOHTTP
	select BR2_PACKAGE_PYTHON_PYYAML
	select BR2_PACKAGE_PYTHON_SERIAL
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_PIPEWIRE
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_LUA
	select BR2_PACKAGE_LUA_5_4
	select BR2_PACKAGE_WIREPLUMBER
	select BR2_PACKAGE_MPV
	select BR2_PACKAGE_MPD
	select BR2_PACKAGE_MPD_PULSEAUDIO
	select BR2_PACKAGE_MPD_CURL
	select BR2_PACKAGE_MPD_FFMPEG
	select BR2_PACKAGE_MPD_MPC
	help
	  ProAudio Player application, alert controller and web UI.
	  Includes PipeWire audio buses and a local MPD source.

if BR2_PACKAGE_PROAUDIO_PLAYER

config BR2_PACKAGE_PROAUDIO_PLAYER_AIRPLAY
	bool "AirPlay receiver"
	default y
	select BR2_PACKAGE_PROAUDIO_SHAIRPORT_SYNC
	help
	  Enable Shairport Sync with the PulseAudio backend and Avahi.

config BR2_PACKAGE_PROAUDIO_PLAYER_DLNA
	bool "DLNA / UPnP renderer"
	default y
	select BR2_PACKAGE_GMRENDER_RESURRECT
	select BR2_PACKAGE_GST1_PLUGINS_GOOD
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_PULSE
	select BR2_PACKAGE_GST1_LIBAV
	help
	  Enable the GStreamer-based DLNA/UPnP renderer.

config BR2_PACKAGE_PROAUDIO_PLAYER_SPOTIFY
	bool "Spotify Connect"
	default y
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_PROAUDIO_SPOTIFYD
	help
	  Enable spotifyd with only the PulseAudio playback backend.

comment "Spotify Connect needs Rust support for the target architecture"
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS

endif

comment "proaudio-player needs systemd, C++, NPTL, wchar, atomics, sync4, gcc >= 12, headers >= 5.6 and dynamic libraries"
	depends on !BR2_INIT_SYSTEMD || !BR2_INSTALL_LIBSTDCPP || !BR2_USE_WCHAR || \
		!BR2_TOOLCHAIN_HAS_THREADS_NPTL || !BR2_TOOLCHAIN_HAS_ATOMIC || \
		!BR2_TOOLCHAIN_HAS_SYNC_4 || !BR2_TOOLCHAIN_GCC_AT_LEAST_12 || \
		!BR2_TOOLCHAIN_HEADERS_AT_LEAST_5_6 || BR2_STATIC_LIBS
