[Unit]
Description=Apply ProAudio Player audio output selection
After=pipewire.service pipewire-pulse.service wireplumber.service
Requires=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=oneshot
ExecStart=/bin/systemctl restart proaudio-player-buses.service
ExecStart=/bin/systemctl try-restart proaudio-player-mpd.service proaudio-player-spotifyd.service proaudio-player-shairport.service proaudio-player-dlna.service
