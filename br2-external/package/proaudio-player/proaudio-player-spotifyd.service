[Unit]
Description=Spotify Connect receiver for ProAudio Player
After=dbus.service network-online.target proaudio-player-buses.service
Wants=dbus.service network-online.target
Requires=proaudio-player-buses.service
ConditionPathExists=/usr/bin/spotifyd

[Service]
Type=simple
User=proaudio-player
Group=proaudio-player
Environment=HOME=/var/lib/proaudio-player
Environment=XDG_RUNTIME_DIR=/run/proaudio-player
Environment=PULSE_SERVER=unix:/run/pulse/native
Environment=PULSE_SINK=proaudio_player_music
ExecStart=/usr/bin/spotifyd --no-daemon --config-path /etc/proaudio-player-alert/spotifyd.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
