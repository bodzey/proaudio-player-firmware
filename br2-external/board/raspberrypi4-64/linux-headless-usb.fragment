# ProAudio Player development kernel policy for Raspberry Pi 4.
# DEV keeps remote/serial diagnostics, but the product is audio-only: no video,
# framebuffer, camera/media, local HID UI or Bluetooth stack is built.

# GPIO character-device API for the physical setup button.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y

# Private non-loopback transport interface for the hidden gmediarender worker.
CONFIG_DUMMY=y

# Raspberry Pi 4 Model B onboard Wi-Fi (BCM43455 over SDIO).
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_MMC=y
CONFIG_MMC_BCM2835=y

# Bluetooth is not used by ProAudio Player.
# CONFIG_BT is not set

# HDMI audio needs the VC4/KMS HDMI pipeline, but no rendering/display stack.
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_VT is not set

# No keyboard/mouse/HID UI and no camera/video/media devices.
CONFIG_INPUT=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_HID is not set
# CONFIG_HIDRAW is not set
# CONFIG_USB_HID is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_USB_VIDEO_CLASS is not set

# USB remains available for DACs and removable media.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_NET_DRIVERS=y
# CONFIG_USB_PRINTER is not set

# Audio outputs: HDMI, USB DAC and future I2S/ASoC carrier-board DACs.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
# CONFIG_SND_BCM2835 is not set
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_HDMI_CODEC=m

# Common removable/external-disk filesystems.
CONFIG_EXT4_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
