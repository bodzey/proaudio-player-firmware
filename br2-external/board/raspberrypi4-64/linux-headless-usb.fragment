# ProAudio Player Raspberry Pi 4 kernel policy.
# This target is an audio appliance. Keep only the board/runtime facilities
# required by proaudio-player-native and its media engines: Ethernet/Wi-Fi,
# IPv4/IPv6 multicast networking, GPIO setup control, PipeWire/ALSA audio,
# HDMI/USB/I2S outputs, ext4 persistent storage and DEV serial diagnostics.
# Hardware-specific I2S codec support belongs in a future target-board profile.

# Core appliance support.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_DUMMY=y
# CONFIG_COMPILE_TEST is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set

# Native DLNA/UPnP discovery needs normal TCP/UDP plus IPv4 multicast.
CONFIG_IP_MULTICAST=y
# CONFIG_IP_SCTP is not set
# CONFIG_CEPH_LIB is not set
# CONFIG_NET_NSH is not set
# CONFIG_MPLS is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_DSA is not set

# Raspberry Pi 4 onboard Ethernet and Wi-Fi only.
CONFIG_BCMGENET=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
# CONFIG_MAC80211 is not set
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
# CONFIG_BRCMDBG is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
CONFIG_MMC=y
CONFIG_MMC_BCM2835=y

# No alternative wireless/protocol/router stacks in the appliance image.
# CONFIG_BT is not set
# CONFIG_ATM is not set
# CONFIG_L2TP is not set
# CONFIG_ATALK is not set
# CONFIG_6LOWPAN is not set
# CONFIG_IEEE802154 is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_OPENVSWITCH is not set
# CONFIG_VSOCKETS is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_NET_9P is not set
# CONFIG_NFC is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_MPTCP is not set
# CONFIG_WIREGUARD is not set
# CONFIG_NET_KEY is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE is not set
# CONFIG_NET_IPVTI is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_IPV6_VTI is not set
# CONFIG_IPV6_GRE is not set

# No virtual/router-oriented or alternate Ethernet devices. The dummy device is
# intentionally retained for the private DLNA transport worker.
# CONFIG_BONDING is not set
# CONFIG_IFB is not set
# CONFIG_MACVLAN is not set
# CONFIG_MACVTAP is not set
# CONFIG_IPVLAN is not set
# CONFIG_VXLAN is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_TUN is not set
# CONFIG_VETH is not set
# CONFIG_NET_VRF is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_MACB is not set
# CONFIG_IGB is not set
# CONFIG_IXGBE is not set
# CONFIG_I40E is not set
# CONFIG_IGC is not set
# CONFIG_ENC28J60 is not set
# CONFIG_LAN743X is not set
# CONFIG_QCA7000_SPI is not set
# CONFIG_QCA7000_UART is not set
# CONFIG_R8169 is not set
# CONFIG_MSE102X is not set
# CONFIG_WIZNET_W5100 is not set
# CONFIG_MICREL_PHY is not set
# CONFIG_MDIO_BITBANG is not set
# CONFIG_USB_NET_DRIVERS is not set

# No local keyboard/mouse/touch UI. The setup button uses gpio-cdev directly.
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_HIDRAW is not set
# CONFIG_USB_HID is not set
# CONFIG_SERIO is not set
# CONFIG_GAMEPORT is not set
# CONFIG_TCG_TPM is not set
# CONFIG_XILLYBUS is not set

# Board buses retained for generic future I2S DAC/control hardware. Keep the
# userspace character interfaces in DEV; remove unrelated controller/mux stacks.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_BCM2835=m
# CONFIG_I2C_BCM2708 is not set
# CONFIG_I2C_BRCMSTB is not set
# CONFIG_I2C_DESIGNWARE_CORE is not set
# CONFIG_I2C_GPIO is not set
# CONFIG_I2C_ROBOTFUZZ_OSIF is not set
# CONFIG_I2C_TINY_USB is not set
# CONFIG_I2C_MUX is not set
CONFIG_SPI=y
CONFIG_SPI_BCM2835=m
CONFIG_SPI_BCM2835AUX=m
CONFIG_SPI_SPIDEV=m
# CONFIG_SPI_DESIGNWARE is not set
# CONFIG_SPI_GPIO is not set
# CONFIG_SPI_RP2040_GPIO_BRIDGE is not set
# CONFIG_SPI_SLAVE is not set
# CONFIG_W1 is not set
# CONFIG_PPS is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_RASPBERRYPI_GPIOMEM is not set
# CONFIG_GPIO_FXL6408 is not set
# CONFIG_GPIO_MAX7300 is not set
# CONFIG_GPIO_PCA953X is not set
# CONFIG_GPIO_PCF857X is not set
# CONFIG_GPIO_MOCKUP is not set

# Local music/state live on the DATA ext4 partition. Native has no removable
# USB-drive mounting contract, so SCSI/UAS/mass-storage are intentionally absent.
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_BLK_DEV_RBD is not set
# CONFIG_MTD is not set
# CONFIG_ZRAM is not set
# CONFIG_BLK_DEV_DRBD is not set
# CONFIG_BLK_DEV_NBD is not set

# HDMI audio needs VC4/KMS for HDMI hotplug/ELD, but no GPU rendering, CEC,
# framebuffer console, panels, backlights, camera or V4L2/media stack.
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_PANEL_LVDS is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9806E_SPI is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9881C is not set
# CONFIG_DRM_PANEL_JDI_LT070ME05000 is not set
# CONFIG_DRM_PANEL_RASPBERRYPI_TOUCHSCREEN is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7701 is not set
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_DRM_PANEL_TPO_Y17P is not set
# CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN is not set
# CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN_V2 is not set
# CONFIG_DRM_DISPLAY_CONNECTOR is not set
# CONFIG_DRM_SIMPLE_BRIDGE is not set
# CONFIG_DRM_TOSHIBA_TC358762 is not set
# CONFIG_DRM_TI_SN65DSI83 is not set
# CONFIG_DRM_RP1_DSI is not set
# CONFIG_DRM_RP1_DPI is not set
# CONFIG_DRM_RP1_VEC is not set
# CONFIG_DRM_PANEL_MIPI_DBI is not set
# CONFIG_TINYDRM_HX8357D is not set
# CONFIG_TINYDRM_ILI9225 is not set
# CONFIG_TINYDRM_ILI9341 is not set
# CONFIG_TINYDRM_ILI9486 is not set
# CONFIG_TINYDRM_MI0283QT is not set
# CONFIG_TINYDRM_REPAPER is not set
# CONFIG_TINYDRM_ST7586 is not set
# CONFIG_TINYDRM_ST7735R is not set
# CONFIG_DRM_GUD is not set
# CONFIG_DRM_SSD130X is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_VT is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_BACKLIGHT_PWM is not set
# CONFIG_BACKLIGHT_RPI is not set
# CONFIG_BACKLIGHT_LM3630A is not set
# CONFIG_BACKLIGHT_GPIO is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_STAGING_MEDIA is not set
# CONFIG_VIDEO_BCM2835 is not set
# CONFIG_VIDEO_CODEC_BCM2835 is not set
# CONFIG_VIDEO_ISP_BCM2835 is not set
# CONFIG_BCM2835_VCHIQ is not set
# CONFIG_STAGING is not set

# Audio outputs required by the hardware-neutral native architecture:
# standard USB Audio Class, HDMI and generic I2S/simple-card.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
# CONFIG_SND_BCM2835 is not set
# CONFIG_SND_OSSEMUL is not set
# CONFIG_SND_PCM_OSS is not set
# CONFIG_SND_SEQUENCER is not set
# CONFIG_SND_DUMMY is not set
# CONFIG_SND_ALOOP is not set
# CONFIG_SND_VIRMIDI is not set
# CONFIG_SND_MTPAV is not set
# CONFIG_SND_SERIAL_U16550 is not set
# CONFIG_SND_MPU401 is not set
# CONFIG_SND_PIMIDI is not set
# CONFIG_SND_PISOUND_MICRO is not set
CONFIG_SND_USB_AUDIO=y
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_CAIAQ is not set
# CONFIG_SND_USB_6FIRE is not set
# CONFIG_SND_USB_HIFACE is not set
# CONFIG_SND_USB_TONEPORT is not set
CONFIG_SND_SOC=y
# CONFIG_SND_SOC_ALL_CODECS is not set
CONFIG_SND_BCM2835_SOC_I2S=m
CONFIG_SND_SOC_HDMI_CODEC=m
CONFIG_SND_SIMPLE_CARD=m
# CONFIG_SND_DESIGNWARE_I2S is not set
# CONFIG_SND_RP1_AUDIO_OUT is not set
# CONFIG_SND_BCM2708_SOC_CHIPDIP_DAC is not set
# CONFIG_SND_BCM2708_SOC_GOOGLEVOICEHAT_SOUNDCARD is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_ADC is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DAC is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DACPLUS is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DACPLUSHD is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DACPLUSADC is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DACPLUSADCPRO is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DACPLUSDSP is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_DIGI is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_AMP is not set
# CONFIG_SND_BCM2708_SOC_PIFI_40 is not set
# CONFIG_SND_BCM2708_SOC_RPI_CIRRUS is not set
# CONFIG_SND_BCM2708_SOC_RPI_DAC is not set
# CONFIG_SND_BCM2708_SOC_RPI_PROTO is not set
# CONFIG_SND_BCM2708_SOC_JUSTBOOM_BOTH is not set
# CONFIG_SND_BCM2708_SOC_JUSTBOOM_DAC is not set
# CONFIG_SND_BCM2708_SOC_JUSTBOOM_DIGI is not set
# CONFIG_SND_BCM2708_SOC_IQAUDIO_CODEC is not set
# CONFIG_SND_BCM2708_SOC_IQAUDIO_DAC is not set
# CONFIG_SND_BCM2708_SOC_IQAUDIO_DIGI is not set
# CONFIG_SND_BCM2708_SOC_I_SABRE_Q2M is not set
# CONFIG_SND_BCM2708_SOC_ADAU1977_ADC is not set
# CONFIG_SND_AUDIOINJECTOR_PI_SOUNDCARD is not set
# CONFIG_SND_AUDIOINJECTOR_OCTO_SOUNDCARD is not set
# CONFIG_SND_AUDIOINJECTOR_ISOLATED_SOUNDCARD is not set
# CONFIG_SND_AUDIOSENSE_PI is not set
# CONFIG_SND_DIGIDAC1_SOUNDCARD is not set
# CONFIG_SND_BCM2708_SOC_DIONAUDIO_LOCO is not set
# CONFIG_SND_BCM2708_SOC_DIONAUDIO_LOCO_V2 is not set
# CONFIG_SND_BCM2708_SOC_ALLO_PIANO_DAC is not set
# CONFIG_SND_BCM2708_SOC_ALLO_PIANO_DAC_PLUS is not set
# CONFIG_SND_BCM2708_SOC_ALLO_BOSS_DAC is not set
# CONFIG_SND_BCM2708_SOC_ALLO_BOSS2_DAC is not set
# CONFIG_SND_BCM2708_SOC_ALLO_DIGIONE is not set
# CONFIG_SND_BCM2708_SOC_ALLO_KATANA_DAC is not set
# CONFIG_SND_BCM2708_SOC_FE_PI_AUDIO is not set
# CONFIG_SND_PISOUND is not set
# CONFIG_SND_DACBERRY400 is not set
# CONFIG_SND_SOC_AD193X_SPI is not set
# CONFIG_SND_SOC_AD193X_I2C is not set
# CONFIG_SND_SOC_ADAU1701 is not set
# CONFIG_SND_SOC_ADAU7002 is not set
# CONFIG_SND_SOC_AK4554 is not set
# CONFIG_SND_SOC_CS4265 is not set
# CONFIG_SND_SOC_ICS43432 is not set
# CONFIG_SND_SOC_MA120X0P is not set
# CONFIG_SND_SOC_MAX98357A is not set
# CONFIG_SND_SOC_PCM3168A_I2C is not set
# CONFIG_SND_SOC_TLV320AIC23_I2C is not set
# CONFIG_SND_SOC_WM8804_I2C is not set
# CONFIG_SND_SOC_WM8904 is not set
# CONFIG_SND_SOC_WM8960 is not set

# USB host is retained solely for USB Audio Class devices/hubs. No USB network,
# serial, gadget, imaging, test or mass-storage stacks are part of native.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
# CONFIG_USB_XHCI_PCI_RENESAS is not set
# CONFIG_USB_DWCOTG is not set
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_UAS is not set
# CONFIG_USB_PRINTER is not set
# CONFIG_USB_TMC is not set
# CONFIG_USB_MON is not set
# CONFIG_USBIP_CORE is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_ACM is not set
# CONFIG_USB_WDM is not set
# CONFIG_USB_MDC800 is not set
# CONFIG_USB_MICROTEK is not set
# CONFIG_USB_ADUTUX is not set
# CONFIG_USB_SEVSEG is not set
# CONFIG_USB_LEGOTOWER is not set
# CONFIG_USB_LCD is not set
# CONFIG_USB_CYPRESS_CY7C63 is not set
# CONFIG_USB_CYTHERM is not set
# CONFIG_USB_IDMOUSE is not set
# CONFIG_USB_APPLEDISPLAY is not set
# CONFIG_USB_LD is not set
# CONFIG_USB_TRANCEVIBRATOR is not set
# CONFIG_USB_IOWARRIOR is not set
# CONFIG_USB_TEST is not set
# CONFIG_USB_ISIGHTFW is not set
# CONFIG_USB_YUREX is not set
# CONFIG_USB_GADGET is not set

# Keep Raspberry Pi thermal/watchdog telemetry only; native does not consume
# generic ADC, battery, fan or environmental-sensor subsystems.
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
CONFIG_BCM2711_THERMAL=y
CONFIG_BCM2835_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=m
# CONFIG_SENSORS_ADT7410 is not set
# CONFIG_SENSORS_AHT10 is not set
# CONFIG_SENSORS_CHIPCAP2 is not set
# CONFIG_SENSORS_DRIVETEMP is not set
# CONFIG_SENSORS_DS1621 is not set
# CONFIG_SENSORS_GPIO_FAN is not set
# CONFIG_SENSORS_IIO_HWMON is not set
# CONFIG_SENSORS_JC42 is not set
# CONFIG_SENSORS_POWERZ is not set
# CONFIG_SENSORS_LM75 is not set
# CONFIG_SENSORS_PWM_FAN is not set
# CONFIG_SENSORS_SHT21 is not set
# CONFIG_SENSORS_SHT3x is not set
# CONFIG_SENSORS_SHT4x is not set
# CONFIG_SENSORS_SHTC1 is not set
# CONFIG_SENSORS_EMC2305 is not set
# CONFIG_SENSORS_ADS7828 is not set
# CONFIG_SENSORS_INA2XX is not set
# CONFIG_SENSORS_INA238 is not set
# CONFIG_SENSORS_TMP102 is not set
# CONFIG_SENSORS_RP1_ADC is not set
# CONFIG_GPIO_WATCHDOG is not set
# CONFIG_MFD_RASPBERRYPI_POE_HAT is not set
# CONFIG_RPI_POE_POWER is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_IIO is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_UIO is not set
# CONFIG_VHOST_NET is not set
# CONFIG_VHOST_VSOCK is not set
# CONFIG_ANDROID_BINDER_IPC is not set

# Runtime filesystems: SYSTEM and DATA are ext4; tmpfs is used by /run. The FAT
# BOOT partition is consumed by Raspberry Pi firmware before Linux and is not a
# runtime filesystem for proaudio-player-native.
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NLS is not set
# CONFIG_UNICODE is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_BCACHEFS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_FSCACHE is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_ECRYPT_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
