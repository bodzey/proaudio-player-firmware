# Development image: keep standard Raspberry Pi 4 display, input and USB support.
# Do not disable device classes here; the bcm2711 defconfig remains the baseline.

# GPIO character-device API for the physical setup button.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y

# Private non-loopback transport interface for the hidden gmediarender worker.
CONFIG_DUMMY=y

# Raspberry Pi 4 Model B onboard Wi-Fi (BCM43455 over SDIO).
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_MMC=y
CONFIG_MMC_BCM2835=y

# Bluetooth is not used by ProAudio Player.
# CONFIG_BT is not set

# HDMI / local console / input for development and diagnostics.
CONFIG_VT=y
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HID=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Raspberry Pi 4 USB host controller and common USB classes.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_PRINTER=m
CONFIG_MEDIA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

# Audio outputs used during development.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_BCM2835=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_HDMI_CODEC=m

# Common removable/external-disk filesystems.
CONFIG_EXT4_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
