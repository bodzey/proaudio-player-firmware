# Native-runtime second-stage pruning for Raspberry Pi 4.
#
# bcm2711_defconfig is deliberately broad. The primary headless fragment removes
# whole subsystems; this fragment removes residual options that survive through
# defaults/selects while preserving the interfaces required by
# proaudio-player-native: TCP/UDP IPv4/IPv6 multicast, BCMGENET, BCM43455 Wi-Fi,
# gpio-cdev, USB Audio, HDMI Audio and generic BCM2835 I2S/simple-card.

# DLM selects IP_SCTP, so disabling IP_SCTP alone is not stable after olddefconfig.
# The player has no cluster-locking or SCTP runtime contract.
# CONFIG_DLM is not set
# CONFIG_IP_SCTP is not set

# USB core selects NLS for USB string handling. Keep only the NLS core; the
# player never mounts FAT/NTFS/legacy-encoded filesystems at runtime.
CONFIG_NLS=y
# CONFIG_NLS_CODEPAGE_437 is not set
# CONFIG_NLS_CODEPAGE_737 is not set
# CONFIG_NLS_CODEPAGE_775 is not set
# CONFIG_NLS_CODEPAGE_850 is not set
# CONFIG_NLS_CODEPAGE_852 is not set
# CONFIG_NLS_CODEPAGE_855 is not set
# CONFIG_NLS_CODEPAGE_857 is not set
# CONFIG_NLS_CODEPAGE_860 is not set
# CONFIG_NLS_CODEPAGE_861 is not set
# CONFIG_NLS_CODEPAGE_862 is not set
# CONFIG_NLS_CODEPAGE_863 is not set
# CONFIG_NLS_CODEPAGE_864 is not set
# CONFIG_NLS_CODEPAGE_865 is not set
# CONFIG_NLS_CODEPAGE_866 is not set
# CONFIG_NLS_CODEPAGE_869 is not set
# CONFIG_NLS_CODEPAGE_874 is not set
# CONFIG_NLS_CODEPAGE_932 is not set
# CONFIG_NLS_CODEPAGE_936 is not set
# CONFIG_NLS_CODEPAGE_949 is not set
# CONFIG_NLS_CODEPAGE_950 is not set
# CONFIG_NLS_CODEPAGE_1250 is not set
# CONFIG_NLS_CODEPAGE_1251 is not set
# CONFIG_NLS_ASCII is not set
# CONFIG_NLS_ISO8859_1 is not set
# CONFIG_NLS_ISO8859_2 is not set
# CONFIG_NLS_ISO8859_3 is not set
# CONFIG_NLS_ISO8859_4 is not set
# CONFIG_NLS_ISO8859_5 is not set
# CONFIG_NLS_ISO8859_6 is not set
# CONFIG_NLS_ISO8859_7 is not set
# CONFIG_NLS_ISO8859_8 is not set
# CONFIG_NLS_ISO8859_9 is not set
# CONFIG_NLS_ISO8859_13 is not set
# CONFIG_NLS_ISO8859_14 is not set
# CONFIG_NLS_ISO8859_15 is not set
# CONFIG_NLS_KOI8_R is not set
# CONFIG_NLS_KOI8_U is not set
# CONFIG_NLS_UTF8 is not set

# Native needs ordinary sockets, not diagnostics, tunnels, IPsec/XFRM or
# alternate congestion-control modules.
# CONFIG_NET_PKTGEN is not set
# CONFIG_INET_DIAG is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_XFRM_USER is not set
# CONFIG_XFRM_INTERFACE is not set
# CONFIG_XFRM_SUB_POLICY is not set
# CONFIG_XFRM_STATISTICS is not set
# CONFIG_NET_FOU is not set
# CONFIG_NET_FOU_IP_TUNNELS is not set
# CONFIG_INET6_AH is not set
# CONFIG_INET6_ESP is not set
# CONFIG_INET6_ESP_OFFLOAD is not set
# CONFIG_INET6_IPCOMP is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set
# CONFIG_IPV6_FOU is not set
# CONFIG_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_IPV6_SEG6_HMAC is not set
# CONFIG_IPV6_IOAM6_LWTUNNEL is not set

# bcm2711_defconfig also carries generic distro/debug compatibility that an
# aarch64-only appliance does not use. Removing it avoids fake NUMA setup,
# 32-bit syscall/emulation paths, tracing tables and module-version metadata.
# CONFIG_IKCONFIG is not set
# CONFIG_GENERIC_IRQ_DEBUGFS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PROFILING is not set
# CONFIG_FTRACE is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_NUMA is not set
# CONFIG_NUMA_EMU is not set
# CONFIG_COMPAT is not set
# CONFIG_ARMV8_DEPRECATED is not set
# CONFIG_SWP_EMULATION is not set
# CONFIG_CP15_BARRIER_EMULATION is not set
# CONFIG_SETEND_EMULATION is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SRCVERSION_ALL is not set
# CONFIG_BLK_DEV_THROTTLING is not set
# CONFIG_ZSWAP is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_OF_CONFIGFS is not set

# Filesystem/block facilities not used by SYSTEM/DATA ext4 storage.
# CONFIG_BINFMT_MISC is not set
# CONFIG_QUOTA is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_ATA_OVER_ETH is not set

# Residual bcm2711 board/peripheral drivers unrelated to the Pi 4 appliance.
# CONFIG_BCMA is not set
# CONFIG_SSB is not set
# CONFIG_XILLYUSB is not set
# CONFIG_CONNECTOR is not set
# CONFIG_FIRMWARE_RP1 is not set
# CONFIG_MBOX_RP1 is not set
# CONFIG_RP1_PIO is not set
# CONFIG_WS2812_PIO_RP1 is not set
