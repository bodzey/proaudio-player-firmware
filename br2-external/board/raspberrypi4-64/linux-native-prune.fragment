# CONFIG_CHARGER_GPIO is not set
# CONFIG_BATTERY_LTC2941 is not set
# CONFIG_PWM_BCM2835 is not set
# CONFIG_PWM_GPIO is not set
# CONFIG_PWM_PCA9685 is not set
# CONFIG_PWM_PIO_RP1 is not set
# CONFIG_PWM_RASPBERRYPI_POE is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY is not set
# CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_V2 is not set
# CONFIG_REGULATOR_WAVESHARE_TOUCHSCREEN is not set

# The hardware-neutral native layer keeps the BCM2835 I2S controller and Linux
# simple-card only. Concrete codec/HAT drivers belong to the final board profile.
# CONFIG_SND_HRTIMER is not set
# CONFIG_SND_RPI_SIMPLE_SOUNDCARD is not set
# CONFIG_SND_RPI_WM8804_SOUNDCARD is not set
# CONFIG_SND_AUDIO_GRAPH_CARD is not set
# CONFIG_SND_SOC_CS4271_I2C is not set
