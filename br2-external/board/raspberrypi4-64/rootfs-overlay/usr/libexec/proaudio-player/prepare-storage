#!/bin/sh
set -eu

data_mount=/data
done_marker=$data_mount/.proaudio-storage-ready
pending_marker=$data_mount/.proaudio-partition-expanded
minimum_free_sectors=4096

log()
{
	printf '%s\n' "proaudio-storage: $*"
}

fail()
{
	log "ERROR: $*"
	exit 1
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || fail "required command '$1' is unavailable"
}

resolve_partition()
{
	source_path=$(readlink -f "$1" 2>/dev/null || true)
	[ -b "$source_path" ] || fail "'$1' does not resolve to a block device"

	partition_name=${source_path##*/}
	partition_sysfs=/sys/class/block/$partition_name
	[ -f "$partition_sysfs/partition" ] || \
		fail "'$source_path' is not a direct disk partition"

	partition_real=$(readlink -f "$partition_sysfs")
	parent_name=$(basename "$(dirname "$partition_real")")
	[ -r "/sys/class/block/$parent_name/size" ] || \
		fail "parent disk for '$source_path' could not be determined"

	RESOLVED_PARTITION=$source_path
	RESOLVED_PARTITION_NAME=$partition_name
	RESOLVED_PARTITION_SYSFS=$partition_sysfs
	RESOLVED_PARENT_NAME=$parent_name
}

partition_table_size()
{
	sfdisk -d "$1" | sed -n \
		"\\|^$2[[:space:]]*:| { s/.*size=[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p; q; }"
}

ensure_data_layout()
{
	mkdir -p \
		"$data_mount/music" \
		"$data_mount/player" \
		"$data_mount/player-alert/media" \
		"$data_mount/player-alert/mpd/playlists"

	# Only normalize the directories owned by the appliance. Never recursively
	# walk the music library at boot: a large library can contain many thousands
	# of files and ownership of files created by the player is already correct.
	chown proaudio-player:proaudio-player \
		"$data_mount/music" \
		"$data_mount/player" \
		"$data_mount/player-alert" \
		"$data_mount/player-alert/media" \
		"$data_mount/player-alert/mpd" \
		"$data_mount/player-alert/mpd/playlists"
	chmod 0755 "$data_mount/music"
	chmod 0750 \
		"$data_mount/player" \
		"$data_mount/player-alert" \
		"$data_mount/player-alert/media" \
		"$data_mount/player-alert/mpd" \
		"$data_mount/player-alert/mpd/playlists"

	for file in \
		provider-settings.yaml \
		audio-settings.yaml \
		state.json \
		audio-output.env
	do
		if [ ! -e "$data_mount/player-alert/$file" ]; then
			: > "$data_mount/player-alert/$file"
		fi
		chown proaudio-player:proaudio-player "$data_mount/player-alert/$file"
		chmod 0600 "$data_mount/player-alert/$file"
	done

	# MPD creates and atomically replaces its binary database itself. An empty
	# placeholder is not a valid database and makes every fresh image log
	# "Database corrupted". Remove placeholders left by older firmware and only
	# pre-create the text state file.
	database_file=$data_mount/player-alert/mpd/database
	if [ -e "$database_file" ] && [ ! -s "$database_file" ]; then
		rm -f "$database_file"
	fi
	state_file=$data_mount/player-alert/mpd/state
	if [ ! -e "$state_file" ]; then
		: > "$state_file"
	fi
	chown proaudio-player:proaudio-player "$state_file"
	chmod 0640 "$state_file"

	factory_dir=/usr/share/proaudio-player/announcements
	for file in alarm_start.mp3 alarm_end.mp3 minute_silence.mp3; do
		target=$data_mount/player-alert/media/$file
		if [ -f "$factory_dir/$file" ] && [ ! -e "$target" ]; then
			cp "$factory_dir/$file" "$target"
		fi
		if [ -e "$target" ]; then
			chown proaudio-player:proaudio-player "$target"
			chmod 0644 "$target"
		fi
	done
}

mark_storage_ready()
{
	touch "$done_marker"
	sync
}

for command_name in findmnt sfdisk resize2fs; do
	require_command "$command_name"
done

read -r data_source data_fstype <<EOF
$(findmnt -n -o SOURCE,FSTYPE "$data_mount")
EOF
[ "$data_fstype" = ext4 ] || fail "'$data_mount' must be an ext4 filesystem"

read -r root_source root_fstype <<EOF
$(findmnt -n -o SOURCE,FSTYPE /)
EOF
[ "$root_fstype" = ext4 ] || fail "root filesystem must be ext4"

resolve_partition "$data_source"
data_partition=$RESOLVED_PARTITION
data_partition_name=$RESOLVED_PARTITION_NAME
data_partition_sysfs=$RESOLVED_PARTITION_SYSFS
disk_name=$RESOLVED_PARENT_NAME
disk=/dev/$disk_name

resolve_partition "$root_source"
[ "$RESOLVED_PARENT_NAME" = "$disk_name" ] || \
	fail "SYSTEM and DATA are not on the same boot disk"
data_partition_number=$(cat "$data_partition_sysfs/partition")
data_partition_start=$(cat "$data_partition_sysfs/start")
data_partition_sectors=$(cat "$data_partition_sysfs/size")
disk_sectors=$(cat "/sys/class/block/$disk_name/size")
data_partition_end=$((data_partition_start + data_partition_sectors))
storage_ready=0
[ -e "$done_marker" ] && storage_ready=1

# Never rewrite a table when DATA is not the final partition. The player can
# still run on the existing DATA capacity, which keeps custom hardware safe.
for candidate in /sys/class/block/*; do
	[ -f "$candidate/partition" ] || continue
	candidate_name=${candidate##*/}
	[ "$candidate_name" = "$data_partition_name" ] && continue
	candidate_real=$(readlink -f "$candidate")
	candidate_parent=$(basename "$(dirname "$candidate_real")")
	[ "$candidate_parent" = "$disk_name" ] || continue
	candidate_start=$(cat "$candidate/start")
	if [ "$candidate_start" -gt "$data_partition_start" ]; then
		log "DATA is not the final partition on '$disk'; preserving the partition table"
		if [ "$storage_ready" -eq 0 ] || [ -e "$pending_marker" ]; then
			resize2fs "$data_partition"
			rm -f "$pending_marker"
		fi
		ensure_data_layout
		if [ "$storage_ready" -eq 0 ]; then
			mark_storage_ready
		fi
		exit 0
	fi
done

unused_sectors=$((disk_sectors - data_partition_end))
if [ "$unused_sectors" -gt "$minimum_free_sectors" ]; then
	if [ -e "$pending_marker" ]; then
		log "stale partition expansion marker detected; retrying expansion"
		rm -f "$pending_marker"
	fi

	log "expanding DATA partition '$data_partition' to fill '$disk'"
	# With sfdisk -N, omitted fields keep their previous values. Explicit '+'
	# in the size field is therefore required to enlarge an existing partition.
	printf ',+\n' | sfdisk --no-reread -N "$data_partition_number" "$disk"
	sync

	on_disk_size=$(partition_table_size "$disk" "$data_partition")
	case $on_disk_size in
		''|*[!0-9]*)
			fail "could not verify the updated DATA partition size"
			;;
	esac
	[ "$on_disk_size" -gt "$data_partition_sectors" ] || \
		fail "partition table update did not enlarge DATA"

	touch "$pending_marker"
	sync
	log "partition table updated; requesting the required one-time reboot"
	systemctl --no-block reboot
	# Keep dependent player services blocked until systemd executes the reboot.
	while :; do
		sleep 60
	done
fi

# resize2fs is needed on first boot and after a partition-table expansion. On
# normal boots the ready marker lets us skip the filesystem scan while still
# re-applying the lightweight directory/file layout below for firmware updates.
if [ "$storage_ready" -eq 0 ] || [ -e "$pending_marker" ]; then
	log "expanding the DATA filesystem on '$data_partition'"
	resize2fs "$data_partition"
	rm -f "$pending_marker"
fi

ensure_data_layout
if [ "$storage_ready" -eq 0 ]; then
	mark_storage_ready
fi
log "persistent storage is ready"
