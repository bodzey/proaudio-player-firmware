#!/bin/sh
set -eu

state_dir=/var/lib/proaudio-storage-grow
done_marker="$state_dir/done"
pending_marker="$state_dir/partition-expanded"
minimum_free_sectors=4096

log()
{
    printf '%s\n' "proaudio-storage-grow: $*"
}

[ -e "$done_marker" ] && exit 0

if ! command -v findmnt >/dev/null 2>&1 ||
   ! command -v sfdisk >/dev/null 2>&1 ||
   ! command -v resize2fs >/dev/null 2>&1; then
    log "required storage tools are unavailable; leaving the filesystem unchanged"
    exit 0
fi

set -- $(findmnt -n -o SOURCE,FSTYPE /)
root_source=${1:-}
root_fstype=${2:-}

case "$root_fstype" in
    ext2|ext3|ext4)
        ;;
    *)
        log "root filesystem '$root_fstype' is not supported; leaving it unchanged"
        exit 0
        ;;
esac

root_partition=$(readlink -f "$root_source" 2>/dev/null || true)
[ -b "$root_partition" ] || {
    log "root source '$root_source' is not a block device; leaving it unchanged"
    exit 0
}

partition_name=${root_partition##*/}
partition_sysfs=/sys/class/block/$partition_name
[ -f "$partition_sysfs/partition" ] || {
    log "root device '$root_partition' is not a directly resizable partition"
    exit 0
}

partition_real=$(readlink -f "$partition_sysfs")
disk_name=$(basename "$(dirname "$partition_real")")
disk=/dev/$disk_name
disk_sysfs=/sys/class/block/$disk_name

[ -b "$disk" ] && [ -r "$disk_sysfs/size" ] || {
    log "parent disk for '$root_partition' could not be determined"
    exit 0
}

partition_number=$(cat "$partition_sysfs/partition")
disk_sectors=$(cat "$disk_sysfs/size")
partition_start=$(cat "$partition_sysfs/start")
partition_sectors=$(cat "$partition_sysfs/size")
partition_end=$((partition_start + partition_sectors))

# Growing is safe only when the root partition is the final partition on disk.
for candidate in /sys/class/block/*; do
    [ -f "$candidate/partition" ] || continue
    candidate_name=${candidate##*/}
    [ "$candidate_name" = "$partition_name" ] && continue

    candidate_real=$(readlink -f "$candidate")
    candidate_disk=$(basename "$(dirname "$candidate_real")")
    [ "$candidate_disk" = "$disk_name" ] || continue

    candidate_start=$(cat "$candidate/start")
    if [ "$candidate_start" -gt "$partition_start" ]; then
        log "root partition is not last on '$disk'; leaving the partition table unchanged"
        exit 0
    fi
done

unused_sectors=$((disk_sectors - partition_end))
mkdir -p "$state_dir"

if [ "$unused_sectors" -gt "$minimum_free_sectors" ]; then
    if [ -e "$pending_marker" ]; then
        log "partition expansion did not become visible after reboot"
        exit 1
    fi

    log "expanding '$root_partition' to fill '$disk'"
    printf ',\n' | sfdisk --no-reread -N "$partition_number" "$disk"
    touch "$pending_marker"
    sync
    systemctl --no-block reboot
    exit 0
fi

log "expanding $root_fstype filesystem on '$root_partition'"
resize2fs "$root_partition"
touch "$done_marker"
rm -f "$pending_marker"
sync
log "storage expansion completed"
