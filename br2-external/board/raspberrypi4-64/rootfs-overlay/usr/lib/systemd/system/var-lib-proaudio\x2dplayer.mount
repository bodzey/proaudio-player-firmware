[Unit]
Description=Bind persistent ProAudio player state
DefaultDependencies=no
Requires=proaudio-storage.service
After=proaudio-storage.service
Conflicts=umount.target
Before=proaudio-storage-layout.target umount.target

[Mount]
What=/data/player
Where=/var/lib/proaudio-player
Type=none
Options=bind
DirectoryMode=0750
