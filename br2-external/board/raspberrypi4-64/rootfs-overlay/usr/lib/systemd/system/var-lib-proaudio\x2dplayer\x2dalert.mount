[Unit]
Description=Bind persistent ProAudio alert state
DefaultDependencies=no
Requires=proaudio-storage.service
After=proaudio-storage.service
Conflicts=umount.target
Before=proaudio-storage-layout.target umount.target

[Mount]
What=/data/player-alert
Where=/var/lib/proaudio-player-alert
Type=none
Options=bind
DirectoryMode=0750
