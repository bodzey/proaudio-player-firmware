[Unit]
Description=Expand ProAudio writable storage to fill the boot device
After=local-fs.target
Before=multi-user.target proaudio-player-buses.service proaudio-player-native.service proaudio-player-spotifyd.service
ConditionPathExists=!/var/lib/proaudio-storage-grow/done

[Service]
Type=oneshot
ExecStart=/usr/libexec/proaudio-player/grow-rootfs
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
