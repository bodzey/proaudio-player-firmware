# ProAudio Player Raspberry Pi 4 USB policy.
# Default-deny all USB interfaces on each host controller.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="usb*", ATTR{interface_authorized_default}="0"

# Allow standard USB Audio Class interfaces (class 01).
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="01", ATTR{authorized}="1", RUN+="/bin/sh -c 'echo %k > /sys/bus/usb/drivers_probe'"

# Allow USB Mass Storage interfaces (class 08).
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="08", ATTR{authorized}="1", RUN+="/bin/sh -c 'echo %k > /sys/bus/usb/drivers_probe'"

# Everything else remains unavailable: HID/input, serial, networking, printers, cameras, etc.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}!="01", ATTR{bInterfaceClass}!="08", ATTR{authorized}="0"
